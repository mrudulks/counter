PORT=4500
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=restaurant_pos
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:8000

# Cloudflare R2 for menu images (leave blank to disable uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Default superadmin (created on startup if no superadmin exists)
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=superadmin@pos.local
SUPERADMIN_PASSWORD=SuperAdmin@123
